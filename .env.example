# Choose "gemini" (recommended to start) or "anthropic".
AI_PROVIDER=gemini
# Server-only secret. Create a key in Google AI Studio; never use a VITE_ prefix or commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional alternative provider:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional comma-separated allowed browser origins. Leave empty for same-origin/dev.
CORS_ORIGIN=
# Future integrations (not used yet)
DATABASE_URL=
SESSION_SECRET=
