{
  "name": "masterstudio-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/local.js",
    "start": "node server/local.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.4.3",
    "typescript": "~5.7.2",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "cors": "^2.8.5",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
